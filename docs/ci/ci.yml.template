name: Sprint 1
on: [push, pull_request]
jobs:
  verify:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:17
        env:
          POSTGRES_PASSWORD: ci_only_password
          POSTGRES_DB: nexokit_test
        ports: ['5432:5432']
        options: --health-cmd pg_isready --health-interval 5s --health-timeout 5s --health-retries 10
    env:
      APP_ENV: development
      APP_BASE_URL: http://127.0.0.1:3000
      DATABASE_URL: postgresql://postgres:ci_only_password@127.0.0.1:5432/nexokit_test
      TEST_DATABASE_URL: postgresql://postgres:ci_only_password@127.0.0.1:5432/nexokit_test
      AUTH_MODE: local
      LOCAL_ADMIN_PASSWORD: ci-admin-only-strong-password
      LOCAL_OPERATOR_PASSWORD: ci-operator-only-strong-password
      SESSION_SECRET: ci-only-session-secret-at-least-32-characters
      TOKEN_SECRET: ci-only-token-secret-at-least-32-characters
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with: { version: 10.34.5 }
      - uses: actions/setup-node@v4
        with: { node-version: '22', cache: pnpm }
      - run: pnpm install --frozen-lockfile
      - run: pnpm db:migrate --local
      - run: pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm build
      - run: pnpm exec playwright install --with-deps chromium
      - run: pnpm test:e2e
