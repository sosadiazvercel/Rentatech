APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://postgres:CHANGE_LOCAL_PASSWORD@127.0.0.1:55432/nexokit_dev
# Optional in production: direct or session-pooler URL used only by `pnpm build` migrations.
MIGRATION_DATABASE_URL=
DATABASE_SSL=false
# Login uses server-side basic credentials in development and production.
# Supabase remains the database; Supabase Auth and AUTH_MODE are not used.
# Optional overrides; leave password empty to use the agreed built-in password.
BASIC_ADMIN_EMAIL=admin@sosadiazeventos.com
BASIC_ADMIN_PASSWORD=
# Legacy local setup values (not used by the administrator login).
LOCAL_ADMIN_EMAIL=admin@sosadiazeventos.com
LOCAL_OPERATOR_EMAIL=operador@example.test
LOCAL_ADMIN_PASSWORD=
LOCAL_OPERATOR_PASSWORD=
SESSION_SECRET=
TOKEN_SECRET=
# Optional kill switch. Omit it or use true to accept quote requests; false disables intake.
COMMERCIAL_ENABLED=true
# Optional transactional email (verified sender domain required).
RESEND_API_KEY=
EMAIL_FROM=
# Internal notification recipients, comma separated; receive a blind copy.
EMAIL_NOTIFICATION_TO=
